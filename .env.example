# 应用
APP_NAME=EnterpriseRAG
DEBUG=true
SECRET_KEY=change-me-dev-secret-key-32bytes

# SQLite（本地文件）
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

# Milvus
MILVUS_MODE=cloud
MILVUS_DB_PATH=./data/milvus_lite.db
ZILLIZ_URI=https://in03-4dd74f0d6a02336.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
ZILLIZ_TOKEN=your-zilliz-cloud-token

# 文件存储
UPLOAD_DIR=./data/files

# 智谱 API（Embedding + Reranker）
ZHIPUAI_API_KEY=your-zhipu-api-key

# DeepSeek（OpenAI 兼容，默认 LLM）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI（可选）
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Qwen（DashScope）
QWEN_API_KEY=your-qwen-api-key

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Embedding
EMBEDDING_MODEL=zhipu-embedding-3
EMBEDDING_DIMENSIONS=1024

# Reranker
RERANKER_MODEL=zhipu-bge-reranker-large

# LLM 默认
DEFAULT_LLM_MODEL=deepseek-chat
